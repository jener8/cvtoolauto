# Supabase (required for cloud sync in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: Supabase Auth user used after CV login (enables RLS on database tables)
# Create this user in Supabase Dashboard → Authentication → Users
#
# REQUIRED for localhost to show the same applications as production.
# Copy values from Vercel → Project → Settings → Environment Variables (Production).
# Note: `vercel env pull` may download empty strings — if so, paste manually from the dashboard.
SUPABASE_APP_USER_EMAIL=cv-app@your-domain.com
SUPABASE_APP_USER_PASSWORD=use-a-long-random-password

# Optional: use browser localStorage only — no Supabase calls (for local dev when DB is down)
# NEXT_PUBLIC_SUPABASE_LOCAL_MODE=true

# Note: SUPABASE_SERVICE_ROLE_KEY is not required for the app runtime.
# Run scripts/013_enable_rls_security.sql in Supabase SQL Editor after creating the app user above.

# AI — server-side only (NEVER use NEXT_PUBLIC_ prefix for API keys)
# Required for: AI strategy analysis, tailored CV generation, statistics chat
# Local: set here in .env.local, then restart: npm run dev
# Vercel: Project → Settings → Environment Variables → redeploy
# See AI_SETUP.md for full guide
OPENAI_API_KEY=sk-your-openai-api-key
# Optional model override (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Alternatives (used only if OPENAI_API_KEY is not set):
# ANTHROPIC_API_KEY=your-anthropic-api-key
# AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
